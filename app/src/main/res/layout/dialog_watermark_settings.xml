<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2C2C2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Watermark Settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <Switch
            android:id="@+id/swWatermarkEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Watermark"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:minHeight="48dp"/>
            
        <!-- Size Adjustment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size / Height"
                android:textColor="#FFD700"
                android:textSize="14sp"/>
                
            <TextView
                android:id="@+id/tvSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5.0%"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="12dp"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbWatermarkSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="50"
            android:progressTint="#FFD700"
            android:thumbTint="#FFFFFF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Style Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Style &amp; Color"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            
            <RadioButton
                android:id="@+id/rbStyleOverlay"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Overlay"
                android:textColor="#FFFFFF"/>
                
            <RadioButton
                android:id="@+id/rbStyleFooter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Footer Frame"
                android:textColor="#FFFFFF"/>
        </RadioGroup>

        <RadioGroup
            android:id="@+id/rgBgColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            
            <RadioButton
                android:id="@+id/rbBgWhite"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="White BG"
                android:textColor="#FFFFFF"/>
                
            <RadioButton
                android:id="@+id/rbBgBlack"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Black BG"
                android:textColor="#FFFFFF"/>
        </RadioGroup>

        <!-- Content Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Content"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"/>

        <Switch
            android:id="@+id/swShowLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Custom Text"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:minHeight="48dp"/>

        <EditText
            android:id="@+id/etCustomText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Logo Text"
            android:text="CAMULATOR"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E8E93"
            android:backgroundTint="#8E8E93"
            android:layout_marginBottom="8dp"/>

        <Switch
            android:id="@+id/swShowTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Time"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:minHeight="48dp"/>

        <Switch
            android:id="@+id/swShowCoords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show GPS Coordinates"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:minHeight="48dp"/>

        <!-- Approximate Location Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Approximate Location"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

        <Switch
            android:id="@+id/swShowDistrict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show City/District"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:minHeight="48dp"/>

        <Switch
            android:id="@+id/swShowStreet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Street"
            android:textColor="#FFFFFF"
            android:checked="false"
            android:minHeight="48dp"/>

        <!-- Layout Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alignment"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            
            <RadioButton
                android:id="@+id/rbPosLeft"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Left"
                android:textColor="#FFFFFF"/>
                
            <RadioButton
                android:id="@+id/rbPosCenter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Center"
                android:textColor="#FFFFFF"/>
                
            <RadioButton
                android:id="@+id/rbPosRight"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Right"
                android:textColor="#FFFFFF"/>
        </RadioGroup>

    </LinearLayout>
</ScrollView>