<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#2C2C2E"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Watermark Settings"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Switch
        android:id="@+id/swWatermarkEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Watermark"
        android:textColor="#FFFFFF"
        android:checked="true"
        android:minHeight="48dp"/>

    <Switch
        android:id="@+id/swShowLogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show Logo (Custom Text)"
        android:textColor="#FFFFFF"
        android:checked="true"
        android:minHeight="48dp"/>

    <EditText
        android:id="@+id/etCustomText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Logo Text"
        android:text="CAMULATOR"
        android:textColor="#FFFFFF"
        android:textColorHint="#8E8E93"
        android:backgroundTint="#8E8E93"
        android:layout_marginBottom="8dp"/>

    <Switch
        android:id="@+id/swShowTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show Time"
        android:textColor="#FFFFFF"
        android:checked="true"
        android:minHeight="48dp"/>

    <Switch
        android:id="@+id/swShowCoords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show Coordinates"
        android:textColor="#FFFFFF"
        android:checked="true"
        android:minHeight="48dp"/>
        
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Text Size"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"/>
        
    <RadioGroup
        android:id="@+id/rgTextSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        
        <RadioButton
            android:id="@+id/rbSmall"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Small"
            android:textColor="#FFFFFF"/>
            
        <RadioButton
            android:id="@+id/rbMedium"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Medium"
            android:textColor="#FFFFFF"/>
            
        <RadioButton
            android:id="@+id/rbLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Large"
            android:textColor="#FFFFFF"/>
    </RadioGroup>

</LinearLayout>