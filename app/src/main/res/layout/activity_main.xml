<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="4:3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Shutter Blackout Overlay -->
    <View
        android:id="@+id/shutterOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#40000000"
        app:layout_constraintTop_toTopOf="parent">
        
        <ImageView
            android:id="@+id/btnAspectRatio"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_aspect_ratio"
            app:tint="#FFFFFF" />
            
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        
        <TextView
            android:text="RAW+J"
            android:textColor="#FF9800"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Focal Length / Zoom Controls -->
    <LinearLayout
        android:id="@+id/focalContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_rounded_panel"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp">

        <TextView android:id="@+id/focal16mm" android:text="16" style="@style/FocalText"/>
        <TextView android:id="@+id/focal24mm" android:text="24" style="@style/FocalText" android:textColor="#FF9800"/>
        <TextView android:id="@+id/focal35mm" android:text="35" style="@style/FocalText"/>
        <TextView android:id="@+id/focal50mm" android:text="50" style="@style/FocalText"/>
        <TextView android:id="@+id/focal85mm" android:text="85" style="@style/FocalText"/>
    </LinearLayout>

    <!-- Bottom Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#80000000"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Thumbnail / Gallery -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/thumbnail"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="32dp"
            android:background="#333333"
            android:padding="1dp"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
            
        <!-- Hidden button overlay for click -->
        <View
            android:id="@+id/btnGallery"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintStart_toStartOf="@id/thumbnail"
            app:layout_constraintTop_toTopOf="@id/thumbnail"/>

        <!-- Shutter Button -->
        <View
            android:id="@+id/btnShutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_shutter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Editor Toggle -->
        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#FFFFFF"
            android:layout_marginEnd="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Editor Overlay (Curves, etc.) -->
    <LinearLayout
        android:id="@+id/layoutEditor"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:orientation="vertical"
        android:background="#EE000000"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <TextView
            android:text="RGB Curves"
            android:textColor="#FFF"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <com.camulator.pro.ui.CurveView
            android:id="@+id/curveView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#222"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>