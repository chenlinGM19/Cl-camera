<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Shutter Blackout Overlay -->
    <View
        android:id="@+id/shutterOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#40000000"
        app:layout_constraintTop_toTopOf="parent">
        
        <ImageView
            android:id="@+id/btnAspectRatio"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_aspect_ratio"
            app:tint="#FFFFFF" />
            
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        
        <TextView
            android:text="PRO RAW"
            android:textColor="#FF9800"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Focal Length / Zoom Controls -->
    <LinearLayout
        android:id="@+id/focalContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_rounded_panel"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp">

        <TextView android:id="@+id/focal16mm" android:text="16" style="@style/FocalText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/focal24mm" android:text="24" style="@style/FocalText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/focal35mm" android:text="35" style="@style/FocalText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/focal50mm" android:text="50" style="@style/FocalText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/focal85mm" android:text="85" style="@style/FocalText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Bottom Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#99000000"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Horizontal EV Slider -->
        <LinearLayout
            android:id="@+id/evContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/shutterContainer">
            
            <TextView 
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-10" 
                android:textColor="#FFF" 
                android:textSize="10sp"/>
                
            <com.google.android.material.slider.Slider
                android:id="@+id/evSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="-10.0"
                android:valueTo="10.0"
                android:stepSize="1.0"
                android:value="0.0"
                app:thumbColor="#FF9800"
                app:trackColorActive="#FF9800"
                app:trackColorInactive="#888888"
                app:tickVisible="false"/>
                
            <TextView 
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+10" 
                android:textColor="#FFF" 
                android:textSize="10sp"/>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/shutterContainer"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:layout_constraintTop_toBottomOf="@id/evContainer"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Thumbnail / Gallery -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/thumbnail"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="32dp"
                android:background="#333333"
                android:padding="1dp"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
                
            <View
                android:id="@+id/btnGallery"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:layout_constraintStart_toStartOf="@id/thumbnail"
                app:layout_constraintTop_toTopOf="@id/thumbnail"/>

            <!-- Shutter Button -->
            <View
                android:id="@+id/btnShutter"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_shutter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Editor Toggle -->
            <ImageView
                android:id="@+id/btnEdit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#FFFFFF"
                android:layout_marginEnd="32dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Processing Indicator -->
    <ProgressBar
        android:id="@+id/processingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="#FF9800"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:elevation="10dp"/>

    <!-- Editor Overlay -->
    <LinearLayout
        android:id="@+id/layoutEditor"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:orientation="vertical"
        android:background="#F0000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <!-- Tab Headers -->
        <HorizontalScrollView 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">
                <TextView android:id="@+id/tabCurves" android:text="Curves" style="@style/ChannelBtn" android:textColor="#FF9800"/>
                <TextView android:id="@+id/tabLight" android:text="Light" style="@style/ChannelBtn" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tabColor" android:text="Color" style="@style/ChannelBtn" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/tabWatermark" android:text="Watermark" style="@style/ChannelBtn" android:textColor="#FFFFFF"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 1. Curves Container -->
        <LinearLayout
            android:id="@+id/containerCurves"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center">
                <TextView android:id="@+id/channelRGB" android:text="RGB" style="@style/ChannelBtn" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/channelR" android:text="Red" style="@style/ChannelBtn" android:textColor="#FF4444"/>
                <TextView android:id="@+id/channelG" android:text="Green" style="@style/ChannelBtn" android:textColor="#44FF44"/>
                <TextView android:id="@+id/channelB" android:text="Blue" style="@style/ChannelBtn" android:textColor="#4444FF"/>
            </LinearLayout>

            <com.camulator.pro.ui.CurveView
                android:id="@+id/curveView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#222"/>
        </LinearLayout>

        <!-- 2. Light Container (Sliders) -->
        <ScrollView
            android:id="@+id/containerLight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                
                <TextView android:text="Highlights" style="@style/EditorLabel"/>
                <SeekBar android:id="@+id/seekHighlights" android:max="200" android:progress="100" style="@style/EditorSlider"/>

                <TextView android:text="Shadows" style="@style/EditorLabel"/>
                <SeekBar android:id="@+id/seekShadows" android:max="200" android:progress="100" style="@style/EditorSlider"/>

                <TextView android:text="Whites" style="@style/EditorLabel"/>
                <SeekBar android:id="@+id/seekWhites" android:max="200" android:progress="100" style="@style/EditorSlider"/>

                <TextView android:text="Blacks" style="@style/EditorLabel"/>
                <SeekBar android:id="@+id/seekBlacks" android:max="200" android:progress="100" style="@style/EditorSlider"/>
            </LinearLayout>
        </ScrollView>

        <!-- 3. Color Grading Container -->
        <LinearLayout
            android:id="@+id/containerColor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:orientation="vertical"
            android:padding="8dp">
            
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
                 <TextView android:id="@+id/btnGradeShadows" android:text="Shadows" style="@style/ChannelBtn" android:textColor="#FF9800"/>
                 <TextView android:id="@+id/btnGradeMids" android:text="Midtones" style="@style/ChannelBtn" android:textColor="#FFF"/>
                 <TextView android:id="@+id/btnGradeHighs" android:text="Highlights" style="@style/ChannelBtn" android:textColor="#FFF"/>
            </LinearLayout>

            <com.camulator.pro.ui.ColorWheelView
                android:id="@+id/colorWheel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="16dp"/>
                
            <TextView android:id="@+id/colorInfo" android:text="Neutral" android:gravity="center" android:textColor="#888" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 4. Watermark Container -->
        <ScrollView
            android:id="@+id/containerWatermark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView android:text="Content Elements" android:textColor="#CCC" android:textSize="12sp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swLogo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Logo/Text"
                    android:checked="true"
                    android:textColor="#FFF"/>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Date &amp; Time"
                    android:checked="true"
                    android:textColor="#FFF"/>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swGPS"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Coordinates"
                    android:checked="true"
                    android:textColor="#FFF"/>

                <TextView android:text="Location Details" android:textColor="#CCC" android:textSize="12sp" android:layout_marginTop="8dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbCity"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="City/District"
                        android:checked="true"
                        android:textColor="#FFF"/>
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbStreet"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Street Name"
                        android:checked="false"
                        android:textColor="#FFF"/>
                </LinearLayout>

                <TextView android:text="Style &amp; Appearance" android:textColor="#CCC" android:textSize="12sp" android:layout_marginTop="8dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    
                    <RadioGroup
                        android:id="@+id/rgStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginEnd="16dp">
                        <RadioButton android:id="@+id/rbFooter" android:text="Footer" android:textColor="#FFF" android:checked="true"/>
                        <RadioButton android:id="@+id/rbOverlay" android:text="Overlay" android:textColor="#FFF" android:layout_marginStart="8dp"/>
                    </RadioGroup>
                    
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                    <ToggleButton
                        android:id="@+id/toggleBgColor"
                        android:layout_width="50dp"
                        android:layout_height="30dp"
                        android:textOn="Wht"
                        android:textOff="Blk"
                        android:background="@drawable/bg_rounded_panel"
                        android:textColor="#FFF"
                        android:checked="true"/>
                </LinearLayout>

                <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal"
                   android:gravity="center_vertical">
                   
                   <TextView 
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="Align:" 
                       android:textColor="#CCC" 
                       android:layout_marginEnd="8dp"/>
                   <ImageView android:id="@+id/alignLeft" android:src="@android:drawable/ic_media_previous" android:layout_width="32dp" android:layout_height="32dp" app:tint="#FFF" android:padding="4dp"/>
                   <ImageView android:id="@+id/alignCenter" android:src="@android:drawable/ic_media_pause" android:layout_width="32dp" android:layout_height="32dp" app:tint="#888" android:padding="4dp"/>
                   <ImageView android:id="@+id/alignRight" android:src="@android:drawable/ic_media_next" android:layout_width="32dp" android:layout_height="32dp" app:tint="#888" android:padding="4dp"/>
                </LinearLayout>

                <TextView 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logo Text" 
                    android:textColor="#CCC" 
                    android:textSize="12sp" 
                    android:layout_marginTop="8dp"/>
                <EditText
                    android:id="@+id/etWatermarkText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Camulator Pro"
                    android:textColor="#FFF"
                    android:backgroundTint="#FF9800"/>

                <TextView 
                    android:id="@+id/tvWatermarkSizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Size: 4.0%" 
                    android:textColor="#CCC" 
                    android:textSize="12sp" 
                    android:layout_marginTop="8dp"/>
                <SeekBar
                    android:id="@+id/seekHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="40"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>