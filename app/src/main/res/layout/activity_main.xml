<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Raw Camera Feed (Hidden behind overlay, but active for sourcing frames) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
        
    <!-- Live Effect Overlay & Editor Preview -->
    <!-- We set background to null so we can see through if needed, but usually this will hold the processed frame -->
    <ImageView
        android:id="@+id/ivPreviewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@android:color/transparent"/>

    <!-- Aspect Ratio Masks (On top of preview) -->
    <View
        android:id="@+id/maskTop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FF000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/centerGuideline"
        app:layout_constraintHeight_percent="0.15" />
        
    <View
        android:id="@+id/centerGuideline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <View
        android:id="@+id/maskBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FF000000"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/centerGuideline"
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintHeight_percent="0.15"/>

    <!-- Top Bar Controls -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#40000000"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnWatermark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"/>
            
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        
        <Button
            android:id="@+id/btnRatio"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="4:3"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>

    <!-- Preset Editor (Slide Up Panel) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/presetEditorContainer"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:background="#F21C1C1E"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Curve &amp; Color Studio"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
            
        <ImageButton
            android:id="@+id/btnCloseEditor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Preset List -->
        <HorizontalScrollView
            android:id="@+id/svPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/tvEditorTitle">
            <LinearLayout
                android:id="@+id/llPresetList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Channel Selector -->
        <LinearLayout
            android:id="@+id/curveChannels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/svPresets">
            
            <Button android:id="@+id/btnCurveRGB" android:layout_width="60dp" android:layout_height="36dp" android:text="RGB" android:textSize="12sp" android:backgroundTint="#FFFFFF" android:textColor="#000" android:layout_marginEnd="8dp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"/>
            <Button android:id="@+id/btnCurveR" android:layout_width="60dp" android:layout_height="36dp" android:text="Red" android:textSize="12sp" android:backgroundTint="#FF453A" android:textColor="#FFF" android:layout_marginEnd="8dp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"/>
            <Button android:id="@+id/btnCurveG" android:layout_width="60dp" android:layout_height="36dp" android:text="Green" android:textSize="12sp" android:backgroundTint="#32D74B" android:textColor="#000" android:layout_marginEnd="8dp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"/>
            <Button android:id="@+id/btnCurveB" android:layout_width="60dp" android:layout_height="36dp" android:text="Blue" android:textSize="12sp" android:backgroundTint="#0A84FF" android:textColor="#FFF" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"/>
        </LinearLayout>

        <!-- Curve View -->
        <com.camulator.pro.CurveView
            android:id="@+id/curveView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="20dp"
            android:background="#442C2C2E"
            app:layout_constraintTop_toBottomOf="@id/curveChannels"
            app:layout_constraintBottom_toTopOf="@id/llSaturation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Saturation Slider -->
        <LinearLayout
            android:id="@+id/llSaturation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/curveActions">
            
            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="SAT"
                android:textColor="#8E8E93"
                android:textStyle="bold"
                android:textSize="12sp"/>
                
            <SeekBar
                android:id="@+id/sbSaturation"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100"
                android:progressTint="#FFD60A"
                android:thumbTint="#FFFFFF"/>
        </LinearLayout>

        <!-- Editor Actions -->
        <LinearLayout
            android:id="@+id/curveActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnImportXmp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Import"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>
            
             <Button
                android:id="@+id/btnSavePreset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnExportXmp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>
                
            <Button
                android:id="@+id/btnResetCurve"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset"
                android:backgroundTint="#FF3B30"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Controls (Hidden when Editor is open) -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_bg_bottom"
        android:orientation="vertical"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Lens Selection -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/focalLengthContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>

        <!-- Filter Selection -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="24dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/filterContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>

        <!-- Bottom Actions Row -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp">

            <!-- Gallery Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnGallery"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#333333"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                
                <ImageView
                    android:id="@+id/ivLastImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="#888888" />
            </androidx.cardview.widget.CardView>

            <!-- Shutter Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnCapture"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:backgroundTint="#FFFFFF"
                app:fabCustomSize="80dp"
                app:borderWidth="4dp"
                app:elevation="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@android:color/transparent" />

            <!-- Edit Button -->
             <ImageButton
                android:id="@+id/btnEditPreset"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@android:drawable/ic_menu_edit"
                android:background="@drawable/circle_bg_translucent"
                app:tint="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
            
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>