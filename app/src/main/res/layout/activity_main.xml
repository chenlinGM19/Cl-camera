<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Preview Container: Can be resized when editor is open -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            
        <ImageView
            android:id="@+id/ivPreviewOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@android:color/transparent"/>

        <View
            android:id="@+id/vShutterFlash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone"/>

        <!-- Masks inside container so they scale/move with it -->
        <View
            android:id="@+id/maskTop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#FF000000"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/centerGuideline"
            app:layout_constraintHeight_percent="0.15" />
            
        <View
            android:id="@+id/centerGuideline"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <View
            android:id="@+id/maskBottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#FF000000"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/centerGuideline"
            app:layout_constraintBottom_toBottomOf="parent" 
            app:layout_constraintHeight_percent="0.15"/>
            
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Top Bar Controls -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="48dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:background="@drawable/gradient_bg_bottom"
        android:rotation="180"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnWatermark"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            android:rotation="180"/>
            
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        
        <Button
            android:id="@+id/btnRatio"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="4:3"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:rotation="180"/>
    </LinearLayout>

    <!-- Preset Editor -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/presetEditorContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#F21C1C1E"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        app:layout_constraintHeight_percent="0.55"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <LinearLayout
            android:id="@+id/editorHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent">
            
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Pro Editor"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"/>
                
            <ImageButton
                android:id="@+id/btnCloseEditor"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/editorHeader"
            app:layout_constraintBottom_toBottomOf="parent">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <!-- Preset List -->
                <HorizontalScrollView
                    android:id="@+id/svPresets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingHorizontal="16dp"
                    android:clipToPadding="false">
                    <LinearLayout
                        android:id="@+id/llPresetList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>

                <!-- Curve Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CURVES"
                    android:textColor="#FFD700"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="20dp"
                    android:layout_marginTop="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">
                    
                    <Button android:id="@+id/btnCurveRGB" android:layout_width="60dp" android:layout_height="36dp" android:text="RGB" android:textSize="12sp" android:backgroundTint="#FFFFFF" android:textColor="#000" android:layout_marginEnd="8dp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"/>
                    <Button android:id="@+id/btnCurveR" android:layout_width="60dp" android:layout_height="36dp" android:text="R" android:textSize="12sp" android:backgroundTint="#FF453A" android:textColor="#FFF" android:layout_marginEnd="8dp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"/>
                    <Button android:id="@+id/btnCurveG" android:layout_width="60dp" android:layout_height="36dp" android:text="G" android:textSize="12sp" android:backgroundTint="#32D74B" android:textColor="#000" android:layout_marginEnd="8dp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"/>
                    <Button android:id="@+id/btnCurveB" android:layout_width="60dp" android:layout_height="36dp" android:text="B" android:textSize="12sp" android:backgroundTint="#0A84FF" android:textColor="#FFF" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp"/>
                </LinearLayout>

                <com.camulator.pro.CurveView
                    android:id="@+id/curveView"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="#442C2C2E"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">
                    <Button
                        android:id="@+id/btnResetCurve"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Reset Curve"
                        android:textSize="12sp"
                        android:backgroundTint="#3A3A3C"/>
                </LinearLayout>

                <!-- Tone Control Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TONE"
                    android:textColor="#FFD700"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="20dp"
                    android:layout_marginTop="8dp"/>

                <!-- Highlights -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:layout_marginTop="8dp">
                    <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="Highlights" android:textColor="#FFF" android:textSize="12sp"/>
                    <SeekBar android:id="@+id/sbHighlights" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="200" android:progress="100" android:progressTint="#FFF" android:thumbTint="#FFF"/>
                </LinearLayout>

                <!-- Shadows -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:layout_marginTop="8dp">
                    <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="Shadows" android:textColor="#FFF" android:textSize="12sp"/>
                    <SeekBar android:id="@+id/sbShadows" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="200" android:progress="100" android:progressTint="#FFF" android:thumbTint="#FFF"/>
                </LinearLayout>

                <!-- Whites -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:layout_marginTop="8dp">
                    <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="Whites" android:textColor="#FFF" android:textSize="12sp"/>
                    <SeekBar android:id="@+id/sbWhites" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="200" android:progress="100" android:progressTint="#FFF" android:thumbTint="#FFF"/>
                </LinearLayout>

                <!-- Blacks -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:layout_marginTop="8dp">
                    <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="Blacks" android:textColor="#FFF" android:textSize="12sp"/>
                    <SeekBar android:id="@+id/sbBlacks" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="200" android:progress="100" android:progressTint="#FFF" android:thumbTint="#FFF"/>
                </LinearLayout>
                
                <!-- Midtones -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:layout_marginTop="8dp">
                    <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="Midtones" android:textColor="#FFF" android:textSize="12sp"/>
                    <SeekBar android:id="@+id/sbMidtones" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="200" android:progress="100" android:progressTint="#FFF" android:thumbTint="#FFF"/>
                </LinearLayout>

                <!-- Color Grading Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="COLOR GRADING"
                    android:textColor="#FFD700"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="20dp"
                    android:layout_marginTop="24dp"/>

                <!-- Saturation -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:layout_marginTop="8dp">
                    <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="Global Sat" android:textColor="#FFF" android:textSize="12sp"/>
                    <SeekBar android:id="@+id/sbSaturation" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="200" android:progress="100" android:progressTint="#FFD60A" android:thumbTint="#FFFFFF"/>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Shadows Tint" android:textColor="#888" android:textSize="10sp" android:paddingHorizontal="20dp" android:layout_marginTop="12dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp">
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="H" android:textColor="#FFF" android:textSize="12sp"/>
                    <SeekBar android:id="@+id/sbShadowHue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="360" android:progress="0" android:progressTint="#0A84FF" android:thumbTint="#0A84FF"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp">
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="S" android:textColor="#FFF" android:textSize="12sp"/>
                    <SeekBar android:id="@+id/sbShadowSat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="100" android:progress="0" android:progressTint="#FFF" android:thumbTint="#FFF"/>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Highlights Tint" android:textColor="#888" android:textSize="10sp" android:paddingHorizontal="20dp" android:layout_marginTop="12dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp">
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="H" android:textColor="#FFF" android:textSize="12sp"/>
                    <SeekBar android:id="@+id/sbHighlightHue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="360" android:progress="0" android:progressTint="#FFD60A" android:thumbTint="#FFD60A"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp">
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="S" android:textColor="#FFF" android:textSize="12sp"/>
                    <SeekBar android:id="@+id/sbHighlightSat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="100" android:progress="0" android:progressTint="#FFF" android:thumbTint="#FFF"/>
                </LinearLayout>

                <!-- Actions -->
                <LinearLayout
                    android:id="@+id/curveActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="32dp"
                    android:paddingBottom="20dp">

                    <Button
                        android:id="@+id/btnImportXmp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Import"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="8dp"/>
                    
                    <Button
                        android:id="@+id/btnExportXmp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Export"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="8dp"/>

                    <Button
                        android:id="@+id/btnSavePreset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save Preset"
                        android:backgroundTint="#FFD700"
                        android:textColor="#000"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Controls -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_bg_bottom"
        android:orientation="vertical"
        android:paddingBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/focalLengthContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnGallery"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#333333"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                
                <ImageView
                    android:id="@+id/ivLastImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="#888888" />
            </androidx.cardview.widget.CardView>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnCapture"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:backgroundTint="#FFFFFF"
                app:fabCustomSize="80dp"
                app:borderWidth="4dp"
                app:elevation="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@android:color/transparent" />

             <ImageButton
                android:id="@+id/btnEditPreset"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@android:drawable/ic_menu_edit"
                android:background="@drawable/circle_bg_translucent"
                app:tint="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
            
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>